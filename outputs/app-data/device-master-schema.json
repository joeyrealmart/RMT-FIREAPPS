{
  "table": "device_master",
  "primary_key": "device_id",
  "fields": [
    {"name": "device_id", "type": "text", "required": true},
    {"name": "device_tag", "type": "text", "required": true},
    {"name": "client_name", "type": "text", "required": true},
    {"name": "site_name", "type": "text", "required": true},
    {"name": "building", "type": "text", "required": false},
    {"name": "floor_area", "type": "text", "required": true},
    {"name": "location_description", "type": "text", "required": true},
    {"name": "device_type", "type": "text", "required": true},
    {"name": "device_type_name", "type": "text", "required": true},
    {"name": "system_type", "type": "text", "required": true},
    {"name": "active_or_passive", "type": "enum", "options": ["Active", "Passive"], "required": true},
    {"name": "zone", "type": "text", "required": false},
    {"name": "qr_barcode", "type": "text", "required": false},
    {"name": "serial_number", "type": "text", "required": false},
    {"name": "brand", "type": "text", "required": false},
    {"name": "model", "type": "text", "required": false},
    {"name": "capacity_size", "type": "text", "required": false},
    {"name": "year_of_manufacture", "type": "number", "required": false},
    {"name": "install_date", "type": "date", "required": false},
    {"name": "bomba_cert_expiry", "type": "date", "required": false},
    {"name": "service_due_date", "type": "date", "required": false},
    {"name": "last_test_date", "type": "date", "required": false},
    {"name": "last_test_result", "type": "enum", "options": ["Pass", "Fail", "N/A", "Pending"], "required": false},
    {"name": "condition_status", "type": "enum", "options": ["Active", "Missing", "Defective", "Replaced", "Removed"], "required": true},
    {"name": "normal_photo_path", "type": "text", "required": false},
    {"name": "nameplate_photo_path", "type": "text", "required": false},
    {"name": "barcode_photo_path", "type": "text", "required": false},
    {"name": "drawing_page", "type": "text", "required": false},
    {"name": "drawio_x", "type": "number", "required": false},
    {"name": "drawio_y", "type": "number", "required": false},
    {"name": "source", "type": "enum", "options": ["First-Time Setup", "CAD", "Hand Sketch", "Manual", "Import"], "required": true},
    {"name": "verification_status", "type": "enum", "options": ["Pending Review", "Confirmed", "Needs Site Check"], "required": true},
    {"name": "remarks", "type": "text", "required": false}
  ]
}
